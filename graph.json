{
  "schema_version": "1.0",
  "schema": {
    "nodes": {
      "shape": "object keyed by node id",
      "required_fields": [
        "id",
        "kind",
        "description"
      ],
      "fields": {
        "id": "Stable node id.",
        "kind": "Logical node type, usually page, form, or state.",
        "description": "Human-readable UI state description.",
        "url_path": "Optional expected URL path or route hint."
      }
    },
    "edges": {
      "shape": "object keyed by edge id",
      "required_fields": [
        "id",
        "from_node",
        "to_node",
        "target_description",
        "selector",
        "action",
        "postcondition",
        "status",
        "last_checked"
      ],
      "fields": {
        "selector": "Primary selector metadata. strategy can be css, role, label, placeholder, text, or test_id. original stores the initial selector strategy.",
        "relocation": "Structured self-heal hints: roles, names, labels, placeholders, text, test_ids, and alternate_selectors.",
        "action": "Action metadata. type can be click, fill, select, or verify. payload_key binds a payload field for fill/select actions.",
        "postcondition": "Expected state after the action. type can be none, action_completed, action_target_has_value, selector_visible, any_selector_visible, text_visible, or url_contains.",
        "status": "verified, stale, or broken.",
        "last_checked": "UTC ISO-8601 timestamp, or null before first successful verification.",
        "last_error": "Latest execution or verification error, if any."
      }
    },
    "skills": {
      "shape": "object keyed by public skill name",
      "required_fields": [
        "name",
        "description",
        "payload_schema",
        "edges"
      ],
      "fields": {
        "payload_schema": "Small JSON-schema-like contract used by replay.py for required string fields and unknown-field rejection.",
        "edges": "Ordered edge ids executed for this skill.",
        "success": "Skill-level success metadata used for the runtime result."
      }
    }
  },
